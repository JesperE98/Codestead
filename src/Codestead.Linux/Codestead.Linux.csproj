<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Codestead.Linux</RootNamespace>
    <AssemblyName>Codestead.Linux</AssemblyName>
    <AssemblyTitle>$(CodesteadLinuxName)</AssemblyTitle>
    <ApplicationIcon>../../build/icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Release builds: no debugger attach info for users, smaller output. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <!--
    Published builds carry their own ICU (Unicode/collation library), so the app does not depend on the
    distribution's libicu version (libicu70/74/76 ... differ between Ubuntu, Debian, Fedora and Arch).
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Codestead.Shell/Codestead.Shell.csproj" />
    <ProjectReference Include="../Codestead.UI/Codestead.UI.csproj" />
    <ProjectReference Include="../Codestead.Content/Codestead.Content.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <!-- Expose the product name from build/Codestead.props to the code. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProductName</_Parameter1>
      <_Parameter2>$(CodesteadLinuxName)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ToolId</_Parameter1>
      <_Parameter2>$(CodesteadLinuxId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

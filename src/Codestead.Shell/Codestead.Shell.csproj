<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Codestead.Shell</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Codestead.Shell.Tests" />
  </ItemGroup>
  <!-- The simulator's own messages and help summaries in every language (see ShellI18n.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="i18n/*.json">
      <LogicalName>shell-i18n/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <!-- The student's computer in every language: names, words and exercise files (see World.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="world/*.json">
      <LogicalName>world/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>

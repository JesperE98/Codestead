<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared Avalonia building blocks for every Codestead tool: theme, markdown view, dialogs, lessons, game views. No simulator. -->
  <PropertyGroup>
    <RootNamespace>Codestead.UI</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Markdig" Version="1.5.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Codestead.Common/Codestead.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Codestead.UI.Tests" />
  </ItemGroup>
</Project>

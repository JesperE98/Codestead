<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Codestead.Content</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Codestead.Shell/Codestead.Shell.csproj" />
    <ProjectReference Include="../../Shared/Codestead.Learning/Codestead.Learning.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Codestead.Content.Tests" />
  </ItemGroup>
  <!--
    Chapter texts and their translations live in src/Linux/content/ (markdown and JSON) and are embedded here. Logical names always use forward slashes: chapters/<lang>/<id>.md,
    i18n/<lang>/<id>.json and ui/<lang>.json.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../content/chapters/**/*.md">
      <LogicalName>chapters/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../content/i18n/**/*.json">
      <LogicalName>i18n/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../content/references/*.json">
      <LogicalName>references/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="i18n/ui/*.json">
      <LogicalName>ui/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>

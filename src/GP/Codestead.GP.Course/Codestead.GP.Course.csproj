<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Codestead GP course: chapters, tasks and their checks, texts per language and API, the starting projects
       of each chapter, and the game (achievements). No UI. -->
  <PropertyGroup>
    <RootNamespace>Codestead.GP.Course</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Codestead.GP.Gpu/Codestead.GP.Gpu.csproj" />
    <ProjectReference Include="../../Shared/Codestead.Learning/Codestead.Learning.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Codestead.GP.Tests" />
  </ItemGroup>
  <!--
    Texts and projects live in src/GP/content/ and are embedded with forward-slash logical names:
    chapters/<lang>/<id>.md, i18n/<lang>/<id>.json, references/<id>.json, ui/<lang>.json and
    projects/<api>/<chapter>/start/<file> + projects/<api>/<chapter>/edits.txt (solution/ and tasks.md stay out:
    the tests read them from disk).
  -->
  <ItemGroup>
    <EmbeddedResource Include="../content/chapters/**/*.md">
      <LogicalName>chapters/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../content/i18n/**/*.json">
      <LogicalName>i18n/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../content/references/*.json">
      <LogicalName>references/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../content/projects/*/*/start/**/*">
      <LogicalName>projects/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../content/projects/*/*/edits.txt">
      <LogicalName>projects/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="i18n/ui/*.json">
      <LogicalName>ui/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>

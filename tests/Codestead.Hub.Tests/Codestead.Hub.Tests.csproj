<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Codestead.Hub.Tests</RootNamespace>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Codestead.Hub.Core/Codestead.Hub.Core.csproj" />
    <ProjectReference Include="../../src/Codestead.Hub/Codestead.Hub.csproj" />
    <!-- Only to check that the hub offers the same languages as Codestead Linux. -->
    <ProjectReference Include="../../src/Codestead.Content/Codestead.Content.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
